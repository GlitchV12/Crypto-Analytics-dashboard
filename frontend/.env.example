# ─── Backend (Railway) ────────────────────────────────────────────
# Find your Railway URL: Railway dashboard → your service → Settings → Domains
# It looks like: https://your-service-production-xxxx.up.railway.app
VITE_API_URL=https://your-railway-app.up.railway.app
VITE_WS_URL=wss://your-railway-app.up.railway.app/ws

# ─── Google OAuth ─────────────────────────────────────────────────
# 1. console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Authorized JS origins: add your Vercel URL
# 4. Paste Client ID below
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
